# Get a free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Live web search (up-to-date answers + source links) ---
# Use ONE of these free search APIs. Fill in its key below and set
# SEARCH_PROVIDER to that name, then ENABLE_LIVE_SEARCH=true.

# 1) Brave Search API (free: 2,000 searches/month) — recommended
#    Sign up: https://brave.com/search/api/  -> copy the API key
BRAVE_SEARCH_KEY=

# 2) Tavily AI search API (free: 1,000 credits/month)
#    Sign up: https://tavily.com  -> copy the API key
TAVILY_API_KEY=

# Choose which provider to use: "brave" or "tavily"
SEARCH_PROVIDER=brave

# Set to true once the search key above is filled in.
ENABLE_LIVE_SEARCH=false