# Get a free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Live Google search (up-to-date answers + source links) ---
# Serper returns REAL Google results (title/link/snippet) — free 2,500
# searches, no credit card needed. Sign up: https://serper.dev
# Other options: Brave (brave.com/search/api, 2,000/month, card required)
#                Tavily (tavily.com, 1,000/month)
SERPER_API_KEY=

# Choose provider: "serper" (recommended), "brave", or "tavily"
SEARCH_PROVIDER=serper

# Set to true once the search key above is filled in.
ENABLE_LIVE_SEARCH=false

# --- PC agent (launch local apps like notepad/chrome/vscode) ---
# true = the assistant may open whitelisted apps on this PC.
# Set to false if you expose this server beyond your own machine.
LOCAL_AGENT_ENABLED=true

# --- Shell commands ---
# true = the assistant may run Windows cmd commands and read their output
# (ipconfig, dir, tasklist, scripts...). Destructive commands are blocked.
ENABLE_SHELL_COMMANDS=true

# --- Public deployment mode (IMPORTANT for sharing the link) ---
# true = safe for public websites: PC tools (app launcher, shell commands,
# website auto-open) are removed entirely; customers get link buttons
# instead of auto-opening. Keep false only for your own private use on PC.
PUBLIC_MODE=false

# --- Shopify (real orders & customers) ---
# Shopify Admin -> Settings -> Apps and sales channels -> Develop apps ->
# Create app -> Configure Admin API scopes (read_orders, read_customers)
# -> Install app -> copy the Admin API access token (shpat_...)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2025-01
