# Get a free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Live Google search (up-to-date answers + source links) ---
# 1) Get a Custom Search JSON API key: https://developers.google.com/custom-search/v1/intro
# 2) Create a Programmable Search Engine:  https://programmablesearchengine.google.com/
#    (copy the "Search engine ID" — the cx value)
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Set to true once GOOGLE_CSE_KEY and GOOGLE_CSE_ID are filled in.
ENABLE_LIVE_SEARCH=false